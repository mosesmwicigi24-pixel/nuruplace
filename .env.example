# ─── Contact form destination ────────────────────────────────────────────────
# The form refuses to submit unless one of these is configured, so a message is
# never silently lost. Set EITHER the webhook OR the email trio.

# Option A — POST the JSON submission to an endpoint you own (for example the
# Pathway pastoral intake, or a Formspree/Zapier hook).
# CONTACT_WEBHOOK_URL=https://example.org/hooks/website-contact

# Option B — hand off to an email provider that accepts a simple POST (Resend).
# CONTACT_EMAIL_TO=pastor@thegoodnewsmission.org
# CONTACT_EMAIL_API=https://api.resend.com/emails
# CONTACT_EMAIL_KEY=re_xxxxxxxxxxxx
# CONTACT_EMAIL_FROM=website@nuruplace.org

# ─── Giving ──────────────────────────────────────────────────────────────────
# Where /give sends a gift, and the secret it signs each one with. BOTH or
# NEITHER: the API refuses unsigned gifts, so a URL with no secret is a 401
# waiting to happen and the page treats that as unconfigured.
#
# Unset, /give says giving from the website is not switched on and points at
# the mission's funding site and a phone number. It never accepts someone's
# M-Pesa number and then does nothing with it.
#
# PATHWAY_GIVING_SECRET must be the SAME value as the API's
# WEBSITE_GIVING_WEBHOOK_SECRET. Generate one with:  openssl rand -hex 32
#
# PATHWAY_API_URL=https://pathway.nuruplace.org/v1
# PATHWAY_GIVING_SECRET=
