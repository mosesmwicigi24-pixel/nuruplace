# ─── Contact form destination ────────────────────────────────────────────────
# The form refuses to submit unless one of these is configured, so a message is
# never silently lost. Set EITHER the webhook OR the email trio.

# Option A — POST the JSON submission to an endpoint you own (for example the
# Pathway pastoral intake, or a Formspree/Zapier hook).
# CONTACT_WEBHOOK_URL=https://example.org/hooks/website-contact

# Option B — hand off to an email provider that accepts a simple POST (Resend).
# CONTACT_EMAIL_TO=pastor@thegoodnewsmission.org
# CONTACT_EMAIL_API=https://api.resend.com/emails
# CONTACT_EMAIL_KEY=re_xxxxxxxxxxxx
# CONTACT_EMAIL_FROM=website@nuruplace.org
